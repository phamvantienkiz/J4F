# FastAPI Configuration
PROJECT_NAME="BurgerPrints Agent"
API_V1_STR="/api/v1"
SECRET_KEY="generate_a_secure_random_string_here_for_jwt_signing"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Relative path from Product/backend/app/db/session.py to Product/ai/data/sqlite.db
DATABASE_URL="sqlite+aiosqlite:///../ai/data/sqlite.db"

# API Settings
# Set to 'false' to use real BurgerPrints integration, or 'true' to use mock data fallbacks
USE_MOCK_API=true

# External API Credentials
BURGERPRINTS_API_KEY="your_burgerprints_api_key_here"
GEMINI_API_KEY="your_google_gemini_api_key_here"
