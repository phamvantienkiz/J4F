# === BurgerPrints API ===
BURGERPRINTS_API_KEY=
BURGERPRINTS_API_BASE_URL=https://api.burgerprints.com/v2
BURGERPRINTS_CATALOG_API_BASE_URL=https://catalog-api.burgerprints.com/api/v1
BURGERPRINTS_ENABLE_SANDBOX_CREATE_ORDER=false

# === LLM Provider (Anthropic) ===
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_DEFAULT_OPUS_MODEL=claude-sonnet-4-20250514
LLM_INTENT_ENABLED=false
LLM_MARKET_ROUTER_ENABLED=false
LLM_GENERAL_FALLBACK_ENABLED=false

# === Azure OpenAI ===
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# === Azure OpenAI Embedding ===
AZURE_OPENAI_EMBED_ENDPOINT=
AZURE_OPENAI_EMBED_API_KEY=
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_EMBED_API_VERSION=2024-12-01-preview

# === Database ===
DATABASE_URL=sqlite:///./database.db

# === Frontend ===
VITE_API_BASE_URL=http://127.0.0.1:8000
